s)  REF: Var=5.21e-03 S_req=8.38e+02 effrank/M=0.068 -> NO-EC\n\n=== GFQK SERISI  H=4 ===\n  H=4 n= 4 M=400 |havuz|=   256 (   0.0s)  REF: Var=8.10e-03 S_req=5.15e+02 effrank/M=0.123 -> NO-EC\n  H=4 n= 6 M=400 |havuz|=  1909 (   0.1s)  REF: Var=9.43e-04 S_req=3.60e+03 effrank/M=0.483 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n= 8 M=400 |havuz|=  7459 (   0.3s)  REF: Var=2.33e-04 S_req=1.47e+04 effrank/M=0.634 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=10 M=400 |havuz|= 20686 (   0.9s)  REF: Var=1.03e-04 S_req=4.20e+04 effrank/M=0.583 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=12 M=400 |havuz|= 46666 (   2.0s)  REF: Var=1.28e-04 S_req=4.38e+04 effrank/M=0.440 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=14 M=250 |havuz|= 91771 (   4.9s)  REF: Var=2.81e-04 S_req=2.80e+04 effrank/M=0.361 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=16 M=250 |havuz|=163669 (  34.4s)  REF: Var=8.64e-04 S_req=1.10e+04 effrank/M=0.210 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=18 M=200 |havuz|=271324 ( 193.8s)  REF: Var=1.45e-03 S_req=6.31e+03 effrank/M=0.196 -> NO-EC\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=4 n=20 M=200 |havuz|=424996 (1303.7s)  REF: Var=1.96e-03 S_req=4.43e+03 effrank/M=0.175 -> NO-EC\n\nKOSU BITTI\n'}], 'source': 'def ck(tag):\n    return os.path.join(CKPT, f\'{tag}.json\')\n\ndef run_fidelity():\n    out = {}\n    for n in N_FID:\n        p = ck(f\'fid_n{n}\')\n        if os.path.exists(p):\n            out[n] = json.load(open(p)); print(f\'  fid n={n}: checkpoint\'); continue\n        t0 = time.time(); M = M_of(n)\n        X = np.random.default_rng(SEED+777*n).uniform(0, 2*np.pi, size=(M, n))\n        res = {}\n        for dep in DEPTHS:\n            for e in ENTS:\n                psi = enc(X, n, dep, e)\n                K, _ = kernel_fidelity(psi)\n                d = diag_(K); d[\'mw\'] = meyer_wallach(psi, n)\n                d[\'status\'], d[\'a_shot\'], d[\'a_learn\'] = layers_(d)\n                res[f\'{dep}|{e}\'] = d\n                del psi, K; free_mem()\n        json.dump(res, open(p, \'w\')); out[n] = res\n        r = res[f\'{REF["depth"]}|{REF["ent"]}\']\n        print(f\'  fid n={n:2d} M={M} ({time.time()-t0:5.1f}s)  REF: mu={r["offdiag_mean"]:.2e} \'\n              f\'(2^-n={2.0**-n:.2e}) Var={r["offdiag_var"]:.2e} S_req={r["s_req"]:.2e} \'\n              f\'effrank/M={r["effrank_frac"]:.3f} -> {r["status"]}\')\n    return out\n\ndef run_series(H):\n    out = {}\n    for n in SERIES[H]:\n        p = ck(f\'H{H}_n{n}\')\n        if os.path.exists(p):\n            out[n] = json.load(open(p)); print(f\'  H={H} n={n}: checkpoint\'); continue\n        t0 = time.time(); M = M_of(n)\n        X = np.random.default_rng(SEED+777*n).uniform(0, 2*np.pi, size=(M, n))\n        lay = pool_layout(n, H); w = lay[3]; res = {}\n        for dep in DEPTHS:\n            for e in ENTS:\n                psi = enc(X, n, dep, e)\n                mw = meyer_wallach(psi, n)\n                E = pauli_expect_fast(psi, n, lay)\n                del psi; free_mem()\n                for pr in PS:\n                    K, s2 = kernel_gfqk(E, w, H, pr)\n                    d = diag_(K, s2); d[\'mw\'] = mw\n                    d[\'status\'], d[\'a_shot\'], d[\'a_learn\'] = layers_(d)\n                    res[f\'{dep}|{e}|{pr}\'] = d\n                    del K; free_mem()\n                del E; free_mem()\n        json.dump(res, open(p, \'w\')); out[n] = res\n        r = res[f\'{REF["depth"]}|{REF["ent"]}|{REF["p"]}\']\n        print(f\'  H={H} n={n:2d} M={M} |havuz|={len(w):6d} ({time.time()-t0:6.1f}s)  REF: \'\n              f\'Var={r["offdiag_var"]:.2e} S_req={r["s_req"]:.2e} \'\n              f\'effrank/M={r["effrank_frac"]:.3f} -> {r["status"]}\')\n    return out\n\nprint(\'=== A0 FIDELITY REFERANSI ===\')\nFID = run_fidelity()\nSER = {}\nfor H in sorted(SERIES):\n    print(f\'\\n=== GFQK SERISI  H={H} ===\')\n    SER[H] = run_series(H)\nprint(\'\\nKOSU BITTI\')'}, {'cell_type': 'markdown', 'id': 'c0b29a0e', 'metadata': {}, 'source': '## Bolum 6 - Katman B: egimler ve ustel/polinom testi'}, {'cell_type': 'code', 'execution_count': 6, 'id': '3ba8567c', 'metadata': {'execution': {'iopub.execute_input': '2026-10-16T16:00:50.695919Z', 'iopub.status.busy': '2026-10-16T16:00:50.695677Z', 'iopub.status.idle': '2026-10-16T16:00:51.356428Z', 'shell.execute_reply': '2026-10-16T16:00:51.355819Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '=== A0 FIDELITY: log Var ~ n egimi  (-ln4 = -1.386 Haar limiti) ===\n         ent=1.0      \ndepth=8      -1.401 \n\nR2 ustel / polinom (REF kosesi):\n  egim=-1.401 [-1.419,-1.388]  R2u=0.9999 R2p=0.9540 dAIC=-55.7 USTEL=True\n\n=== GFQK SERILERI: egim H ile nasil degisiyor ===\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=2 (n<=20): egim=-0.048 [-0.084,-0.002] R2u=0.477 R2p=0.589 USTEL=False  |  ustel onayli 0/1 konfig\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  H=3 (n<=20): egim=+0.039 [-0.074,+0.185] R2u=0.069 R2p=0.006 USTEL=False  |  ustel onayli 0/1 konfig\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': "  H=4 (n<=20): egim=-0.006 [-0.263,+0.262] R2u=0.001 R2p=0.057 USTEL=False  |  ustel onayli 0/1 konfig\n\n=== KATMAN A: hangi n'de tetikleniyor (REF kosesi) ===\n  n |   A0 S_req  A0 er/M  A0 durum | H=2 S_req/er/durum | H=3 S_req/er/durum | H=4 S_req/er/durum\n  4 |   1.00e+01    0.123     NO-EC | 1.3e+02 0.03 NO-EC     | 2.8e+02 0.08 NO-EC     | 5.2e+02 0.12 NO-EC     | \n  6 |   4.35e+01    0.728     NO-EC | 4.2e+02 0.03 NO-EC     | 1.3e+03 0.18 NO-EC     | 3.6e+03 0.48 NO-EC     | \n  8 |   1.78e+02    0.979  EC-LEARN | 6.2e+02 0.02 NO-EC     | 3.8e+03 0.16 NO-EC     | 1.5e+04 0.63 NO-EC     | \n 10 |   7.60e+02    0.999  EC-LEARN | 5.9e+02 0.01 NO-EC     | 5.0e+03 0.09 NO-EC     | 4.2e+04 0.58 NO-EC     | \n 12 |   3.14e+03    1.000  EC-LEARN | 5.2e+02 0.01 NO-EC     | 2.6e+03 0.05 NO-EC     | 4.4e+04 0.44 NO-EC     | \n 14 |   1.30e+04    1.000  EC-LEARN | 6.1e+02 0.02 NO-EC     | 1.7e+03 0.05 NO-EC     | 2.8e+04 0.36 NO-EC     | \n 16 |   5.05e+04    1.000  EC-LEARN | 5.7e+02 0.02 NO-EC     | 9.8e+02 0.04 NO-EC     | 1.1e+04 0.21 NO-EC     | \n 18 |   1.93e+05    1.000   EC-BOTH | 6.7e+02 0.04 NO-EC     | 9.1e+02 0.06 NO-EC     | 6.3e+03 0.20 NO-EC     | \n 20 |   7.85e+05    1.000   EC-BOTH | 7.1e+02 0.05 NO-EC     | 8.4e+02 0.07 NO-EC     | 4.4e+03 0.18 NO-EC     | \n"}], 'source': 'def slopes_for(getter, ns_list, keys):\n    out = {}\n    for k in keys:\n        ns = [n for n in ns_list if k in getter(n)]\n        if len(ns) < 3: continue\n        out[k] = layer_b(ns, [getter(n)[k][\'offdiag_var\'] for n in ns])\n    return out\n\nfid_keys = [f\'{d}|{e}\' for d in DEPTHS for e in ENTS]\nSL_FID = slopes_for(lambda n: FID[n], N_FID, fid_keys)\n\nprint(\'=== A0 FIDELITY: log Var ~ n egimi  (-ln4 = -1.386 Haar limiti) ===\')\nprint(f\'{"":9s}\' + \'\'.join(f\'ent={e:<9}\' for e in ENTS))\nfor d in DEPTHS:\n    print(f\'depth={d:<3} \' + \'\'.join(f\'{SL_FID[f"{d}|{e}"]["slope"]:+9.3f} \' for e in ENTS))\nprint(\'\\nR2 ustel / polinom (REF kosesi):\')\ns = SL_FID[f\'{REF["depth"]}|{REF["ent"]}\']\nprint(f\'  egim={s["slope"]:+.3f} [{s["slope_lo"]:+.3f},{s["slope_hi"]:+.3f}]  \'\n      f\'R2u={s["r2_exp"]:.4f} R2p={s["r2_poly"]:.4f} dAIC={s["d_aic"]:+.1f} USTEL={s["exponential"]}\')\n\nprint(\'\\n=== GFQK SERILERI: egim H ile nasil degisiyor ===\')\nSL_SER = {}\nfor H in sorted(SERIES):\n    keys = [f\'{d}|{e}|{p}\' for d in DEPTHS for e in ENTS for p in PS]\n    SL_SER[H] = slopes_for(lambda n, H=H: SER[H][n], SERIES[H], keys)\n    k = f\'{REF["depth"]}|{REF["ent"]}|{REF["p"]}\'\n    s = SL_SER[H][k]; nexp = sum(1 for v in SL_SER[H].values() if v and v[\'exponential\'])\n    print(f\'  H={H} (n<={max(SERIES[H])}): egim={s["slope"]:+.3f} \'\n          f\'[{s["slope_lo"]:+.3f},{s["slope_hi"]:+.3f}] R2u={s["r2_exp"]:.3f} \'\n          f\'R2p={s["r2_poly"]:.3f} USTEL={s["exponential"]}  |  ustel onayli \'\n          f\'{nexp}/{len(SL_SER[H])} konfig\')\n\nprint(\'\\n=== KATMAN A: hangi n\\\'de tetikleniyor (REF kosesi) ===\')\nprint(f\'{"n":>3} | {"A0 S_req":>10} {"A0 er/M":>8} {"A0 durum":>9} | \' +\n      \' | \'.join(f\'H={H} S_req/er/durum\' for H in sorted(SERIES)))\nfor n in N_FID:\n    f_ = FID[n][f\'{REF["depth"]}|{REF["ent"]}\']\n    row = f\'{n:>3} | {f_["s_req"]:>10.2e} {f_["effrank_frac"]:>8.3f} {f_["status"]:>9} | \'\n    for H in sorted(SERIES):\n        if n in SER.get(H, {}):\n            g = SER[H][n][f\'{REF["depth"]}|{REF["ent"]}|{REF["p"]}\']\n            row += f\'{g["s_req"]:.1e} {g["effrank_frac"]:.2f} {g["status"]:<9} | \'\n        else:\n            row += f\'{"-":>21} | \'\n    print(row)'}, {'cell_type': 'markdown', 'id': 'cb869bdd', 'metadata': {}, 'source': '## Bolum 7 - GRAFIKLER'}, {'cell_type': 'code', 'execution_count': 7, 'id': '45f61790', 'metadata': {'execution': {'iopub.execute_input': '2026-10-16T16:00:51.359256Z', 'iopub.status.busy': '2026-10-16T16:00:51.358980Z', 'iopub.status.idle': '2026-10-16T16:00:54.475250Z', 'shell.execute_reply': '2026-10-16T16:00:54.474642Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '  -> F1_variance_vs_n.png\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  -> F2_shots_vs_n.png\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  -> F3_effrank_vs_n.png\n  -> F4_axis_attribution.png\n'}, {'name': 'stdout', 'output_type': 'stream', 'text': '  -> F5_resolvable_fraction.png\n'}, {'data': {'image/png': '\n', 'text/plain': '<Figure size 624x456 with 1 Axes>'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'image/png': '\n', 'text/plain': '<Figure size 624x456 with 1 Axes>'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'image/png': '\n', 'text/plain': '<Figure size 624x456 with 1 Axes>'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'image/png': '\n', 'text/plain': '<Figure size 528x408 with 2 Axes>'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'image/png': '\n', 'text/plain': '<Figure size 1140x360 with 3 Axes>'}, 'metadata': {}, 'output_type': 'display_data'}], 'source': 'plt.rcParams.update({\'figure.dpi\': 120, \'font.size\': 9, \'axes.grid\': True,\n                     \'grid.alpha\': 0.3, \'figure.autolayout\': True})\nFIGS = []\ndef save(fig, name):\n    fig.savefig(name, bbox_inches=\'tight\'); FIGS.append(name); print(\'  ->\', name)\n\nrk  = f\'{REF["depth"]}|{REF["ent"]}\'\nrkp = f\'{REF["depth"]}|{REF["ent"]}|{REF["p"]}\'\n\n# --- F1: log Var vs n -- ANA FIGUR ---\nfig, ax = plt.subplots(figsize=(5.2, 3.8))\nv = [FID[n][rk][\'offdiag_var\'] for n in N_FID]\nax.semilogy(N_FID, v, \'o-\', c=\'crimson\', lw=2, ms=5, label=\'A0 fidelity kernel\')\nnn = np.array(N_FID, float)\nax.semilogy(nn, v[0]*4.0**(-(nn-nn[0])), \'--\', c=\'crimson\', alpha=.45, lw=1.2,\n            label=r\'Haar limiti $4^{-n}$\')\nfor H, c in zip(sorted(SERIES), [\'#1f77b4\', \'#2ca02c\', \'#ff7f0e\']):\n    ns = SERIES[H]\n    ax.semilogy(ns, [SER[H][n][rkp][\'offdiag_var\'] for n in ns], \'s-\', c=c, lw=2, ms=4,\n                label=f\'GFQK $w\\\\leq{H}$\')\nax.set_xlabel(\'qubit sayisi $n$\'); ax.set_ylabel(r\'Var$[k(x,x^\\prime)]$\')\nax.set_title(f\'Konsantrasyon: fidelity USTEL, agirlik-kesikli DEGIL\\n\'\n             f\'(depth={REF["depth"]}, ent={REF["ent"]}, bw={BW})\', fontsize=9)\nax.legend(fontsize=7.5); save(fig, \'F1_variance_vs_n.png\')\n\n# --- F2: S_req vs n + butce cizgileri (kesisme) ---\nfig, ax = plt.subplots(figsize=(5.2, 3.8))\nax.semilogy(N_FID, [FID[n][rk][\'s_req\'] for n in N_FID], \'o-\', c=\'crimson\', lw=2, ms=5,\n            label=\'A0 fidelity\')\nax.semilogy(nn, 2.0**nn, \'--\', c=\'crimson\', alpha=.45, lw=1.2, label=r\'kapali form $2^n$\')\nfor H, c in zip(sorted(SERIES), [\'#1f77b4\', \'#2ca02c\', \'#ff7f0e\']):\n    ns = SERIES[H]\n    ax.semilogy(ns, [SER[H][n][rkp][\'s_req\'] for n in ns], \'s-\', c=c, lw=2, ms=4,\n                label=f\'GFQK $w\\\\leq{H}$\')\nfor S, ls in zip(SHOT_BUDGETS, [\':\', \'-\', \':\']):\n    ax.axhline(S, color=\'k\', ls=ls, lw=1.4 if S == LOCK_BUDGET else .8, alpha=.6)\n    ax.text(N_FID[0], S*1.4, f\'butce {S:.0e}\' + (\' (KILIT)\' if S == LOCK_BUDGET else \'\'),\n            fontsize=6.5, color=\'k\')\nax.set_xlabel(\'qubit sayisi $n$\'); ax.set_ylabel(r\'$S_{req}=\\sigma^2_{shot}/$Var\')\nax.set_title(\'Olcum maliyeti: kesisme noktasi\', fontsize=9)\nax.legend(fontsize=7.5, loc=\'lower right\'); save(fig, \'F2_shots_vs_n.png\')\n\n# --- F3: A-learn -- effrank/M vs n ---\nfig, ax = plt.subplots(figsize=(5.2, 3.8))\nax.plot(N_FID, [FID[n][rk][\'effrank_frac\'] for n in N_FID], \'o-\', c=\'crimson\', lw=2, ms=5,\n        label=\'A0 fidelity\')\nfor H, c in zip(sorted(SERIES), [\'#1f77b4\', \'#2ca02c\', \'#ff7f0e\']):\n    ns = SERIES[H]\n    ax.plot(ns, [SER[H][n][rkp][\'effrank_frac\'] for n in ns], \'s-\', c=c, lw=2, ms=4,\n            label=f\'GFQK $w\\\\leq{H}$\')\nax.axhline(EFFRANK_GATE, color=\'k\', ls=\'--\', lw=1.2)\nax.text(N_FID[0], EFFRANK_GATE+.02, f\'A-learn esigi {EFFRANK_GATE}\', fontsize=7)\nax.set_ylim(0, 1.05); ax.set_xlabel(\'qubit sayisi $n$\')\nax.set_ylabel(r\'effrank$(K)/M$\')\nax.set_title(r\'Ogrenme seviyesinde EC: $K\\to I$ (shot\\\'tan bagimsiz)\', fontsize=9)\nax.legend(fontsize=7.5); save(fig, \'F3_effrank_vs_n.png\')\n\n# --- F4: eksen atfi -- derinlik x dolaniklik egim isi haritasi ---\nZ = np.array([[SL_FID[f\'{d}|{e}\'][\'slope\'] for e in ENTS] for d in DEPTHS])\nfig, ax = plt.subplots(figsize=(4.4, 3.4))\nim = ax.imshow(Z, cmap=\'RdBu_r\', vmin=-1.5, vmax=0, aspect=\'auto\')\nax.set_xticks(range(len(ENTS)), [str(e) for e in ENTS])\nax.set_yticks(range(len(DEPTHS)), [str(d) for d in DEPTHS])\nax.set_xlabel(\'dolaniklik  $ent$\'); ax.set_ylabel(\'derinlik  $depth$\')\nfor i in range(len(DEPTHS)):\n    for j in range(len(ENTS)):\n        ax.text(j, i, f\'{Z[i,j]:.2f}\', ha=\'center\', va=\'center\', fontsize=7.5,\n                color=\'w\' if Z[i, j] < -0.9 else \'k\')\nax.set_title(\'A0 egimi: derinlik tek basina EC uretmiyor\\n(ent=0 sutunu duz)\', fontsize=8.5)\nax.grid(False); fig.colorbar(im, ax=ax, label=\'log Var / n egimi\')\nsave(fig, \'F4_axis_attribution.png\')\n\n# --- F5: butceye gore cozulebilir cift orani ---\nfig, axs = plt.subplots(1, len(SHOT_BUDGETS), figsize=(9.5, 3.0), sharey=True)\nfor a, S in zip(axs, SHOT_BUDGETS):\n    a.plot(N_FID, [FID[n][rk][f\'resolv@{S:.0e}\'] for n in N_FID], \'o-\', c=\'crimson\',\n           lw=1.8, ms=4, label=\'A0\')\n    for H, c in zip(sorted(SERIES), [\'#1f77b4\', \'#2ca02c\', \'#ff7f0e\']):\n        ns = SERIES[H]\n        a.plot(ns, [SER[H][n][rkp][f\'resolv@{S:.0e}\'] for n in ns], \'s-\', c=c, lw=1.8,\n               ms=3, label=f\'$w\\\\leq{H}$\')\n    a.set_title(f\'butce {S:.0e} shot\', fontsize=8.5); a.set_xlabel(\'$n$\'); a.set_ylim(-.03, 1.03)\naxs[0].set_ylabel(\'cozulebilir cift orani\'); axs[0].legend(fontsize=7)\nsave(fig, \'F5_resolvable_fraction.png\')\nplt.show()'}, {'cell_type': 'markdown', 'id': '74d9d765', 'metadata': {}, 'source': '## Bolum 8 - Bolge listesi + indirme'}, {'cell_type': 'code', 'execution_count': 8, 'id': 'ab4e5826', 'metadata': {'execution': {'iopub.execute_input': '2026-10-16T16:00:54.478540Z', 'iopub.status.busy': '2026-10-16T16:00:54.478312Z', 'iopub.status.idle': '2026-10-16T16:00:54.513500Z', 'shell.execute_reply': '2026-10-16T16:00:54.512983Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': "=== BOLGE LISTESI: 7 hucre (A+C) -> 7 (A+B+C, KULLANILACAK) ===\nCounter({('A0_fidelity', 'EC-LEARN'): 5, ('A0_fidelity', 'EC-BOTH'): 2})\nB kapisinda elenen: 0  | B gecenlerin ent dagilimi: {1.0: 7}\n\nEN ONEMLI: A0 EC iken GFQK degil (ayni n, depth, ent) -- ALTIN HUCRELER\n21 altin hucre (A+C) -> 21 B-onayli (KULL